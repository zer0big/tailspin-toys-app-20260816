---
import type { Category, Publisher } from '../types/game';

/**
 * Props for the catalog controls that filter prerendered game cards in place.
 */
interface Props {
    /** Alphabetically ordered category choices rendered as a multi-select checkbox group. */
    categories: Category[];
    /** Alphabetically ordered publisher choices rendered as a single-select control. */
    publishers: Publisher[];
    /** Number of prerendered cards used to initialize the accessible result summary. */
    totalGames: number;
}

const { categories, publishers, totalGames } = Astro.props;
---

<section
    class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5 shadow-lg backdrop-blur-sm"
    aria-labelledby="game-filters-heading"
>
    <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 id="game-filters-heading" class="text-xl font-semibold text-slate-100">
                Filter games
            </h2>
            <p class="text-sm text-slate-300">
                Search by title, then choose any categories and one publisher.
            </p>
        </div>
        <p
            class="text-sm font-medium text-blue-300"
            role="status"
            aria-live="polite"
            aria-atomic="true"
            data-testid="game-filter-summary"
        >
            {totalGames} of {totalGames} games shown.
        </p>
    </div>

    <form data-game-filters data-testid="game-filters">
        <div class="grid gap-6 lg:grid-cols-[minmax(14rem,1fr)_minmax(0,2fr)_minmax(14rem,1fr)_auto] lg:items-end">
            <label class="flex flex-col gap-2 font-medium text-slate-100">
                Search by title
                <input
                    type="search"
                    name="title"
                    placeholder="Enter a game title"
                    autocomplete="off"
                    class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 placeholder:text-slate-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    data-testid="game-title-search"
                />
            </label>

            <fieldset>
                <legend class="mb-3 font-medium text-slate-100">Categories</legend>
                <div class="flex flex-wrap gap-3">
                    {categories.map((category) => (
                        <label
                            class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/60 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500 hover:text-slate-100"
                        >
                            <input
                                type="checkbox"
                                name="category"
                                value={category.id}
                                class="h-4 w-4 rounded border-slate-500 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                                data-testid={`category-filter-${category.id}`}
                            />
                            {category.name}
                        </label>
                    ))}
                </div>
            </fieldset>

            <label class="flex flex-col gap-2 font-medium text-slate-100">
                Publisher
                <select
                    name="publisher"
                    class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    data-testid="publisher-filter"
                >
                    <option value="">All publishers</option>
                    {publishers.map((publisher) => (
                        <option value={publisher.id}>{publisher.name}</option>
                    ))}
                </select>
            </label>

            <button
                type="button"
                class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:border-blue-500 hover:bg-slate-700 hover:text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50"
                data-testid="clear-game-filters"
                disabled
            >
                Clear filters
            </button>
        </div>
    </form>
</section>

<div
    class="rounded-xl border border-slate-700 bg-slate-800/50 py-12 text-center"
    data-testid="filter-empty-state"
    hidden
>
    <p class="text-slate-300" data-testid="filter-empty-state-text">
        No games match your search or selected filters.
    </p>
</div>

<script>
    const filterForm = document.querySelector<HTMLFormElement>('[data-game-filters]');
    const titleSearch = filterForm?.querySelector<HTMLInputElement>('input[name="title"]');
    const publisherSelect = filterForm?.querySelector<HTMLSelectElement>('select[name="publisher"]');
    const clearButton = filterForm?.querySelector<HTMLButtonElement>('[data-testid="clear-game-filters"]');
    const resultSummary = document.querySelector<HTMLElement>('[data-testid="game-filter-summary"]');
    const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
    const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

    function applyGameFilters(): void {
        if (!filterForm || !titleSearch || !publisherSelect || !clearButton || !resultSummary || !gamesGrid || !emptyState) {
            return;
        }

        const titleQuery = titleSearch.value.trim().toLocaleLowerCase();
        const selectedCategories = new Set(
            Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]:checked'))
                .map((input) => input.value),
        );
        const selectedPublisher = publisherSelect.value;
        let visibleGames = 0;

        for (const card of gameCards) {
            const matchesTitle = titleQuery === ''
                || (card.dataset.gameTitle ?? '').toLocaleLowerCase().includes(titleQuery);
            const matchesCategory = selectedCategories.size === 0
                || selectedCategories.has(card.dataset.categoryId ?? '');
            const matchesPublisher = selectedPublisher === ''
                || selectedPublisher === card.dataset.publisherId;
            const isVisible = matchesTitle && matchesCategory && matchesPublisher;

            card.hidden = !isVisible;
            if (isVisible) {
                visibleGames++;
            }
        }

        const hasFilters = titleQuery !== ''
            || selectedCategories.size > 0
            || selectedPublisher !== '';
        clearButton.disabled = !hasFilters;
        gamesGrid.hidden = visibleGames === 0;
        emptyState.hidden = visibleGames !== 0;
        resultSummary.textContent = `${visibleGames} of ${gameCards.length} games shown.`;
    }

    filterForm?.addEventListener('input', applyGameFilters);
    filterForm?.addEventListener('change', applyGameFilters);
    clearButton?.addEventListener('click', () => {
        filterForm?.reset();
        applyGameFilters();
    });
</script>
